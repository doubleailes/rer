+                    request_strs,
+                    None,
+                    load_family=lambda name, version_range=None:
+                        self._load_family(pyrer, name, version_range),
+                    package_repository=rer_repo,
+                    load_package=lambda name, version:
+                        self._load_package(pyrer, name, version),
+                    variant_select_mode=mode,
+                )
+                self._count_rer_loads(before, rer_repo.stats())
+            elif _supports_load_family(pyrer):
                 result = pyrer.solve(
                     request_strs,
                     None,
@@ -261,6 +403,27 @@ class RerSolver:
             "backend": "pyrer",
         }
 
+    def _load_package(self, pyrer: Any, name: str, version: str) -> Any:
+        """``load_package`` fallback for pyrer.PackageRepository: one
+        package pyrer handed back (dynamic definition, late-bound requires,
+        ...) is loaded by rez."""
+        pkg = get_package(name, version, paths=self.package_paths)
+        if pkg is None:
+            raise RezSystemError("package %s-%s not found" % (name, version))
+        return _make_package_data_slow(pyrer, pkg, str(pkg.version))
+
+    def _count_rer_loads(self, before: dict, after: dict) -> None:
+        """Fire ``package_load_callback`` once per package pyrer loaded, so
+        ``ResolvedContext.num_loaded_packages`` keeps counting (only used
+        when the callback ignores its argument, see _only_counts_loads)."""
+        if self.package_load_callback is None:
+            return
+        n = after["packages_rust"] - before["packages_rust"]
+        n += sum(after["packages_python"].values()) - \
+            sum(before["packages_python"].values())
+        for _ in range(n):
+            self.package_load_callback(None)
+
     def _load_family(self, pyrer: Any, name: str,
                      version_range: str | None = None) -> list[Any]:
         """Lazy ``load_family`` callback fed to ``pyrer.solve``.
@@ -363,8 +526,39 @@ class RerSolver:
                 or "rer solver reported status %r" % status_str
             )
 
+    def _rer_package(self, name: str, version: str) -> Package | None:
+        """The rez Package for a package pyrer loaded, built from the
+        repository pyrer found it in (first path wins, as in
+        ``get_package``) without re-listing the family."""
+        from rez.package_repository import package_repository_manager
+        from rez.packages import Package
+        from rezplugins.package_repository.filesystem import \
+            FileSystemPackageResource
+
+        found = self._rer_repo.iter_packages(name, "==" + version)
+        if not isinstance(found, list) or len(found) != 1:
+            return None
+        filepath = found[0][2]
+        if filepath is None:
+            return None
+        import os
+        location = os.path.dirname(os.path.dirname(os.path.dirname(filepath)))
+        locations = self._rer_repo.locations()
+        if location not in locations:
+            return None
+        path = self.package_paths[locations.index(location)]
+        repo = package_repository_manager.get_repository(path)
+        resource = repo.get_resource(FileSystemPackageResource.key,
+                                     location=repo.location,
+                                     name=name, version=version)
+        return Package(resource)
+
     def _make_package_variant(self, rv: Any) -> PackageVariant:
-        pkg = get_package(rv.name, rv.version, paths=self.package_paths)
+        pkg = None
+        if self._rer_repo is not None:
+            pkg = self._rer_package(rv.name, rv.version)
+        if pkg is None:
+            pkg = get_package(rv.name, rv.version, paths=self.package_paths)
         if pkg is None:
             raise RezSystemError(
                 "rer solver resolved package %s-%s, but it could not be "
diff --git a/src/rez/rezconfig.py b/src/rez/rezconfig.py
index ef710e7..761f795 100644
--- a/src/rez/rezconfig.py
+++ b/src/rez/rezconfig.py
@@ -409,6 +409,15 @@ variant_select_mode = "version_priority"
 # of those should continue to use the default solver.
 use_rer_solver = False
 
+# When ``use_rer_solver`` is enabled, also let ``pyrer`` (>= the release that
+# ships ``pyrer.PackageRepository``) list filesystem package repositories and
+# load ``package.py`` / ``package.yaml`` definitions in Rust. Definitions
+# that need Python (``@early``, imports, anything not a literal) and layouts
+# pyrer doesn't model are still loaded by rez, per package or per family.
+# Not used for resolves with a package filter or a user package-load
+# callback, or for non-filesystem repositories.
+use_rer_package_loader = False
+
