         self._failure_description: str = ""
         self._num_iterations: int = 0
+        self._rer_repo: Any = None
 
     @property
     def status(self) -> SolverStatus:
@@ -223,7 +346,26 @@ class RerSolver:
             mode = getattr(config, "variant_select_mode", None) \
                 or "version_priority"
 
-            if _supports_load_family(pyrer):
+            rer_repo = None
+            if not self.package_filter and \
+                    _only_counts_loads(self.package_load_callback):
+                rer_repo = _rer_package_repository(pyrer, self.package_paths)
+
+            self._rer_repo = rer_repo
+            if rer_repo is not None:
