diff --git a/src/rez/rer_solver.py b/src/rez/rer_solver.py
index c20bdb5..5334918 100644
--- a/src/rez/rer_solver.py
+++ b/src/rez/rer_solver.py
@@ -92,6 +92,128 @@ def _supports_batched_static_parser(pyrer: Any) -> bool:
     return hasattr(pyrer, "parse_static_packages_py")
 
 
+def _supports_package_repository(pyrer: Any) -> bool:
+    """True if pyrer can list and load filesystem repositories itself."""
+    return hasattr(pyrer, "PackageRepository") and hasattr(pyrer, "load_package_file")
+
+
+# One pyrer.PackageRepository per (paths, settings), kept for the process
+# like rez's own repository caches; cleared with them (see _install_hooks).
+_rer_repositories: dict = {}
+
+
+def _filesystem_locations(paths: list[str]) -> list[str] | None:
+    """Plain locations if every path is a filesystem repository, else None."""
+    out = []
+    for path in paths:
+        if "@" in path:
+            repo_type, location = path.split("@", 1)
+            if repo_type != "filesystem":
+                return None
+            out.append(location)
+        else:
+            out.append(path)
+    return out
+
+
+def _rer_package_repository(pyrer: Any, paths: list[str]) -> Any | None:
+    from rez.config import config
+
+    if not getattr(config, "use_rer_package_loader", False):
+        return None
+    if not _supports_package_repository(pyrer):
+        return None
+    locations = _filesystem_locations(paths)
+    if locations is None:
+        return None
+    _install_hooks(pyrer)
+    fs = config.plugins.package_repository.filesystem
+    key = (tuple(locations), tuple(fs.package_filenames),
+           bool(config.allow_unversioned_packages),
+           bool(fs.check_package_definition_files))
+    repo = _rer_repositories.get(key)
+    if repo is None:
+        repo = pyrer.PackageRepository(
+            locations,
+            package_filenames=list(fs.package_filenames),
+            allow_unversioned_packages=bool(config.allow_unversioned_packages),
+            check_package_definition_files=bool(fs.check_package_definition_files),
+        )
+        _rer_repositories[key] = repo
+    return repo
+
+
+def _only_counts_loads(callback: Callable | None) -> bool:
+    """True if ``callback`` is None, or is ResolvedContext's internal
+    ``_package_load_callback`` wrapping no user callback (it then only
+    increments ``num_loaded_packages`` and ignores its argument)."""
+    if callback is None:
+        return True
+    code = getattr(callback, "__code__", None)
+    if code is None or code.co_name != "_package_load_callback" \
+            or "package_load_callback" not in code.co_freevars:
+        return False
+    cell = callback.__closure__[code.co_freevars.index("package_load_callback")]
+    return cell.cell_contents is None
+
+
+_hooks_installed = False
+
+
+def _install_hooks(pyrer: Any) -> None:
+    """Route rez's filesystem definition loading through pyrer (falling
+    back to rez's loader per file), and clear pyrer's caches with rez's."""
+    global _hooks_installed
+    if _hooks_installed:
+        return
+    _hooks_installed = True
+
+    import os
+    from rez import serialise
+    from rez.config import config
+    from rez.package_repository import PackageRepositoryManager
+    from rez.utils.sourcecode import SourceCode
+    from rezplugins.package_repository import filesystem as fs_plugin
+
+    original_load = fs_plugin.FileSystemPackageResource._load
+
+    def _to_rez(data: dict, filepath: str) -> dict:
+        for key, value in data.items():
+            if isinstance(value, pyrer.SourceCodeData):
+                sc = SourceCode.__new__(SourceCode)
+                sc.__setstate__({
+                    "source": value.source,
+                    "filepath": filepath,
+                    "funcname": value.funcname,
+                    "eval_as_function": value.eval_as_function,
+                    "decorators": value.decorators,
+                })
+                data[key] = sc
+        return data
+
+    def _load(self):
+        if getattr(config, "use_rer_package_loader", False):
+            filepath = self.filepath
+            if filepath is not None:
+                realpath = os.path.realpath(filepath)
+                if realpath not in serialise.file_cache:
+                    data = pyrer.load_package_file(realpath, self.file_format.extension)
+                    if isinstance(data, dict):
+                        return _to_rez(data, realpath)
+        return original_load(self)
+
+    fs_plugin.FileSystemPackageResource._load = _load
+
+    original_clear = PackageRepositoryManager.clear_caches
+
+    def clear_caches(self) -> None:
+        original_clear(self)
+        for repo in _rer_repositories.values():
+            repo.clear_caches()
+
+    PackageRepositoryManager.clear_caches = clear_caches
+
+
 class RerSolver:
     """A :class:`rez.solver.Solver`-compatible front-end that delegates the
     resolve to :func:`pyrer.solve`.
@@ -144,6 +266,7 @@ class RerSolver:
